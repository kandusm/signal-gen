# signalgen environment.
#
# Copy to `.env` and fill in. Every value below is a placeholder; `.env` is
# gitignored and no real secret belongs in this file or anywhere else in the
# repo (architecture-spec.md section 11).
#
# Config is validated with zod at boot and the process refuses to start on an
# invalid value, so a typo here surfaces immediately rather than at the first
# post.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Database --------------------------------------------------------------
# Local development: the docker-compose Postgres. Both URLs are the same
# because there is no pooler in front of it.
#   docker compose up -d db
DATABASE_URL=postgresql://signalgen:signalgen@localhost:5432/signalgen
DIRECT_URL=postgresql://signalgen:signalgen@localhost:5432/signalgen
#
# Production (Supabase): DATABASE_URL is the pooled Supavisor string and MUST
# carry ?pgbouncer=true; DIRECT_URL is the direct connection and is used only
# by migrations.
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:6543/postgres?pgbouncer=true
#   DIRECT_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres

# --- Design Manager --------------------------------------------------------
DM_BASE_URL=https://sartorial.commvergent.com
# DM's Api:SignalKey. One key per deployed generator; rotate by issuing a new
# one and updating this value.
DM_SIGNAL_KEY=replace-me-dm-signal-key
# Sent to DM as `sourceKey`, identifying this deployment. Max 32 characters.
GENERATOR_SOURCE_KEY=signalgen-v1

# --- Manual adapter --------------------------------------------------------
# Bearer token for POST /manual/signals. The endpoint itself arrives in
# Phase 1; the token is provisioned now so config does not change then.
# Generate with: openssl rand -hex 32
MANUAL_API_TOKEN=replace-me-manual-api-token

# --- Alerting (MailWain) ---------------------------------------------------
MAILWAIN_BASE_URL=https://mail-wain.fly.dev
MAILWAIN_API_KEY=replace-me-mailwain-api-key
# Sender address. Its domain must be registered and ACTIVE for the MailWain
# org that owns MAILWAIN_API_KEY, or every send is rejected.
ALERT_FROM=signalgen@replace-me.example.com
# Recipients, comma-separated. architecture-spec.md OQ-6 is still open on
# whether Chris is on this list.
ALERT_TO=replace-me@example.com

# --- Safety valves ---------------------------------------------------------
# Leave true. Flipping this to false makes every accepted candidate a real
# post to Design Manager. The supervised first post is a deliberate, human-run
# step: set BUDGET_TOTAL_24H=1, flip this to false, watch the ledger, then put
# both back (build-plan.md section 4).
DRY_RUN=true

# --- Rate budgets (trailing 24 hours) --------------------------------------
# DM allows 10 requests/minute and 500/day per key. The per-minute ceiling is
# enforced in process; these are the daily halves. Per-adapter caps exist so
# one noisy source cannot starve the others; the difference between the total
# and the sum of the adapters is deliberate headroom.
BUDGET_TOTAL_24H=500
BUDGET_MANUAL_24H=50
BUDGET_REDDIT_24H=100
