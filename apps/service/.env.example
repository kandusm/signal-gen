# signalgen environment.
#
#   cp apps/service/.env.example apps/service/.env
#
# This file lives beside the service on purpose: Prisma's CLI looks for `.env`
# in the package and schema directories and does NOT search up to the
# workspace root, so a root-level .env would be silently ignored by every
# migration command.
#
# Two files are loaded, in order, via Node's native --env-file-if-exists:
#
#   .env        this file, filled in. Local development. Prisma reads it too.
#   .env.local  overrides, for staged Supabase credentials and real secrets.
#
# Later wins, and a real process environment variable (a Fly secret) beats
# both — so neither file can affect production.
#
# Every value below is a placeholder. `.env` and `.env.local` are gitignored
# and no real secret belongs in the repo (architecture-spec.md section 11).
#
# Config is validated with zod at boot and the process refuses to start on an
# invalid value, so a typo here surfaces immediately rather than at the first
# post.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Database --------------------------------------------------------------
# Keep these pointed at the docker-compose Postgres. Both URLs are identical
# because there is no pooler in front of it.
#   docker compose up -d db
#
# Supabase credentials belong in `.env.local`, not here. Prisma's CLI reads
# this file, and `prisma migrate dev` creates and drops a shadow database and
# will offer to reset the target -- so a remote URL in this file is the one
# genuinely dangerous mistake available. `pnpm migrate:dev` refuses to run
# against a non-local host for exactly that reason.
# 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 (::1) first and
# the compose container listens on IPv4 only, so every new connection stalls
# ~2s - exactly Prisma's interactive-transaction maxWait, which then fails.
DATABASE_URL=postgresql://signalgen:signalgen@127.0.0.1:5432/signalgen
DIRECT_URL=postgresql://signalgen:signalgen@127.0.0.1:5432/signalgen

# --- Design Manager --------------------------------------------------------
DM_BASE_URL=https://sartorial.commvergent.com
# DM's Api:SignalKey. One key per deployed generator; rotate by issuing a new
# one and updating this value.
DM_SIGNAL_KEY=replace-me-dm-signal-key
# Sent to DM as `sourceKey`, identifying this deployment. Max 32 characters.
GENERATOR_SOURCE_KEY=signalgen-v1

# --- Manual adapter --------------------------------------------------------
# Bearer token for POST /manual/signals. The endpoint itself arrives in
# Phase 1; the token is provisioned now so config does not change then.
# Generate with: openssl rand -hex 32
MANUAL_API_TOKEN=replace-me-manual-api-token

# --- Alerting (MailWain) ---------------------------------------------------
MAILWAIN_BASE_URL=https://mail-wain.fly.dev
MAILWAIN_API_KEY=replace-me-mailwain-api-key
# Sender address. Its domain must be registered and ACTIVE for the MailWain
# org that owns MAILWAIN_API_KEY, or every send is rejected.
ALERT_FROM=signalgen@replace-me.example.com
# Recipients, comma-separated. architecture-spec.md OQ-6 is still open on
# whether Chris is on this list.
ALERT_TO=replace-me@example.com

# --- Safety valves ---------------------------------------------------------
# Leave true. Flipping this to false makes every accepted candidate a real
# post to Design Manager. The supervised first post is a deliberate, human-run
# step: set BUDGET_TOTAL_24H=1, flip this to false, watch the ledger, then put
# both back (build-plan.md section 4).
DRY_RUN=true

# --- Rate budgets (trailing 24 hours) --------------------------------------
# DM allows 10 requests/minute and 500/day per key. The per-minute ceiling is
# enforced in process; these are the daily halves. Per-adapter caps exist so
# one noisy source cannot starve the others; the difference between the total
# and the sum of the adapters is deliberate headroom.
BUDGET_TOTAL_24H=500
BUDGET_MANUAL_24H=50
BUDGET_SEARCH_24H=100

# --- Dedup suppression windows (days) ---------------------------------------
# How long a fingerprint suppresses repeats (architecture-spec.md section 8).
# Suppressed candidates are still ledgered, as status=suppressed.
SUPPRESS_MANUAL_DAYS=7
SUPPRESS_SEARCH_DAYS=21

# --- signalId shortcodes ---------------------------------------------------
# Prefixes the signalId sent to DM ("man_01J8...", "srch_01J8..."), so a row in
# DM's review queue is legible without a lookup. Optional: the default below is
# the convention in architecture-spec.md. An adapter with no entry gets a
# shortcode derived from its key.
# ADAPTER_SHORTCODES=manual:man,search:srch
