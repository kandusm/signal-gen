// Data model per docs/architecture-spec.md §7.
//
// One documented deviation: `Signal.nextAttemptAt`, added by the Phase 0
// brief so the sweep can own the retry schedule.
//
// All DateTime columns are `Timestamptz(3)`. Prisma's default mapping is a
// bare `timestamp`, which stores no zone and silently depends on the server's
// TZ setting. build-plan.md §9 requires all storage timestamps to be UTC
// ISO-8601, so the zone is made explicit at the column rather than assumed
// from the environment. The container also pins TZ=UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// The ledger. Every candidate that reaches the DM client lands here before
/// any network call, and never leaves. Also the telemetry hook for a future
/// DM outcome endpoint (architecture-spec.md §7, §15).
model Signal {
  /// signalId as sent to DM: "{shortcode}_{ULID}".
  id            String    @id
  /// sha256(adapterKey|topic|subtopic) per architecture-spec.md §8.
  /// Recorded in Phase 0; dedup/suppression that reads it is Phase 1.
  fingerprint   String
  /// Which adapter produced the candidate. Drives per-adapter budgets.
  adapterKey    String
  /// The generator instance identity sent to DM (GENERATOR_SOURCE_KEY).
  sourceKey     String
  topic         String
  subtopic      String?
  tone          String
  platform      String
  /// The exact body as validated and posted.
  payload       Json
  /// pending | posted | suppressed | dry_run | failed | failed_permanent
  /// | rejected_schema | rejected_tone
  status        String
  attempts      Int       @default(0)
  dmStatusCode  Int?
  /// Parsed DM response body, or a structured description of why there was
  /// no usable response. JSON rather than text so a contract drift can be
  /// queried across the ledger instead of grepped.
  dmResponse    Json?
  /// When the sweep may next touch this row. Null means "eligible now".
  nextAttemptAt DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  postedAt      DateTime? @db.Timestamptz(3)

  @@index([fingerprint])
  @@index([adapterKey, createdAt])
  // Trailing-24h budget counting, total and per adapter.
  @@index([status, postedAt])
  @@index([adapterKey, status, postedAt])
  // Sweep drain: pending/retry-due rows, oldest first.
  @@index([status, nextAttemptAt, createdAt])
}

/// Dedup state. Written by the Phase 1 pipeline; present in Phase 0 so the
/// initial migration matches §7 and Phase 1 adds no table.
model Fingerprint {
  /// sha256(adapterKey | adapter-defined material) per architecture-spec.md §8.
  hash               String    @id
  adapterKey         String
  firstSeenAt        DateTime  @db.Timestamptz(3)
  lastSeenAt         DateTime  @db.Timestamptz(3)
  lastPostedSignalId String?
  suppressUntil      DateTime? @db.Timestamptz(3)
}

/// One row per adapter invocation, success or failure. Written in Phase 1.
model AdapterRun {
  id                Int       @id @default(autoincrement())
  adapterKey        String
  startedAt         DateTime  @db.Timestamptz(3)
  finishedAt        DateTime? @db.Timestamptz(3)
  /// ok | failed
  status            String
  itemsFetched      Int       @default(0)
  candidatesEmitted Int       @default(0)
  error             String?

  @@index([adapterKey, startedAt])
}

/// Persisted copy of DM's taxonomy, so a DM outage at boot degrades to stale
/// data instead of no data (architecture-spec.md §5).
model TaxonomySnapshot {
  id        Int      @id @default(autoincrement())
  fetchedAt DateTime @db.Timestamptz(3)
  /// Raw GET /api/secondarydesigns/categories response.
  body      Json

  @@index([fetchedAt])
}
